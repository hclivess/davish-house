# Copy to /etc/davish/env (chmod 600). Restart the service after editing.
DAVISH_SECRET=change-me-to-a-long-random-string
DAVISH_DB=/var/lib/davish/davish.db
DAVISH_BASE_URL=http://208.87.242.141
DAVISH_SITE_NAME="Davish's House"
DAVISH_DEFAULT_LANG=es
DAVISH_UPLOAD_DIR=/var/lib/davish/uploads
DAVISH_DEFAULT_TZ=America/Merida
DAVISH_DEFAULT_STAY_HOURS=4
DAVISH_GUEST_FEE_PCT=0
DAVISH_HOST_FEE_PCT=0
DAVISH_CURRENCY=MXN
DAVISH_PHONE=+52 999 398 2548
DAVISH_WHATSAPP=529993982548

# Stripe. Leave STRIPE_SECRET_KEY empty for simulated payments (no charges). Webhook endpoint: <base url>/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Outbound email (password resets, welcome mail). Leave SMTP_HOST empty to log emails to the journal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_TLS=starttls
